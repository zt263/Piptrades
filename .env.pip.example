# Kalshi environment: demo or production
KALSHI_ENV=demo
KALSHI_API_KEY_ID=
# Railway can store the PEM as a multiline secret. Escaped \n is also supported.
KALSHI_PRIVATE_KEY_PEM=

# Pip starts in paper mode from the database defaults.
PIP_DB_PATH=/data/pip.db
PIP_DASHBOARD_TOKEN=change-me

# This is intentionally false. Live mode in the UI cannot send real-money orders
# until this server-side gate is deliberately set to true.
PIP_LIVE_EXECUTION_ENABLED=false
